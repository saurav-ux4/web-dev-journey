<file path="grid/grid6/style.css">
html{

}

body{
    margin:0;
    padding:10px;
    box-sizing: border-box;

}

main{
    min-height:100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(250px, 40vh) 2fr;
    gap:12px;
}

.hero{
    grid-column: 1/-1;
    aspect-ratio: 16/9;
    grid-row:1/2;
    background-image: url(images/mountain.jpg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.first-sub{
    grid-column:1/2;
    grid-row:2/3;
    background-image: url(images/pexels-alex-revilla-2154326563-36018670.jpg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

.second-sub{
    grid-column:2/3;
    grid-row:2/3;
    background-image:url(images/pexels-vizart-10255883.jpg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

section{
    border-radius: 15px;
}


@media (min-width:600px) and (max-width: 1024px){
    body{
        padding:5px;
        margin:0;
    } 

    main{
    height:100vh;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
}


.hero{
    grid-column: 1/2;
    grid-row: unset; 
   
}

.first-sub{
    grid-column:2/3;
    grid-row: unset; 
   
}


.second-sub{
    grid-column:3/4;
    grid-row: unset; 
   
}


}
